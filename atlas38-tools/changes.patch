+add('supine-arms','仰卧 · 双手放头旁','卧躺',o=>lying('supine',o),{handTargetR:[-.22,.01,-.60],handTargetL:[.22,.01,-.60],elbowPoleR:[-.4,.01,-.40],elbowPoleL:[.4,.01,-.40]},'上肢不再贴躯干；肩部与床面的支撑位置改变，肩部不适不能仅由角度判断。',['armsUp']);
