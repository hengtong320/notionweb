+   const x=point.x-c.a.x,y=point.y-c.a.y,z=point.z-c.a.z,t=T.MathUtils.clamp((x*c.dx+y*c.dy+z*c.dz)/c.lengthSq,0,1),dx=x-c.dx*t,dy=y-c.dy*t,dz=z-c.dz*t,d=dx*dx+dy*dy+dz*dz;
